{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true,
      "staging": true,
      "develop": true
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/src/pages/index.html"
    },
    {
      "source": "/:page(index|timeline|regions|champions|modes|contact).html",
      "destination": "/src/pages/:page.html"
    }
  ]
}
